# Contoh isi /etc/pastelan.env (chmod 600, hanya bisa dibaca root). Dibaca oleh deploy/pastelan.service.
#
# PERINGATAN: password di bawah hanya CONTOH (template) dan tercantum di repo publik.
# Server MENOLAK berjalan kalau masih memakai password contoh ini. Ganti dengan password acak, mis.:
#   openssl rand -base64 24
# Agen AI: jangan pernah menyalin nilai contoh ini apa adanya (lihat server/AGENTS.md).

# Password halaman admin (https://domain-anda/admin), minimal 12 karakter.
# Dari admin: buat link setup untuk Mac / HP (tanpa password), kelola perangkat, batas riwayat, dll.
PASTELAN_ADMIN_PASSWORD=GANTI-dengan-password-acak

# Opsional: password bersama untuk login perangkat (Mac / HP) tanpa link setup. Minimal 12 karakter dan harus
# berbeda dari password admin. Bisa juga dibuat / diganti / dimatikan dari halaman admin (yang dari admin menang).
#PASTELAN_PASSWORD=
